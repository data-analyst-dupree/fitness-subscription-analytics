      <column caption='First Order Date' datatype='date' name='[Calculation_1086922262081536]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [Customer_ID] : MIN([Transaction_Date]) }' />
      </column>
      <column caption='Cohort Month' datatype='datetime' name='[Calculation_1086922264920066]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[Calculation_1086922262081536])' />
      </column>
      <column caption='Months Since First Purchase' datatype='integer' name='[Calculation_1086922265554947]' role='measure' type='quantitative'>
